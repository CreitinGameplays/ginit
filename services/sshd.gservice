service "sshd" {
    meta {
        description = "OpenSSH Server"
        deps {
            after = ["network"]
            requires = ["network"]
        }
    }

    process {
        type = "simple"
        user = "root"
        group = "root"

        commands {
            start = "/usr/libexec/geminios/sshd-launch"
        }

        lifecycle {
            restart_policy = "always"
            restart_delay = "2s"
            stop_timeout = "10s"
        }
    }

    install {
        wanted_by = ["multi-user.target"]
    }
}
